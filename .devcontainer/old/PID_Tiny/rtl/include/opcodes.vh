`ifndef PID_TINY_OPCODES_VH
`define PID_TINY_OPCODES_VH

`define OP_ADD   4'h0
`define OP_SUB   4'h1
`define OP_MUL   4'h2
`define OP_LOAD  4'h3
`define OP_STORE 4'h4
`define OP_LI    4'h5
`define OP_JMP   4'h6
`define OP_SAR   4'h7
`define OP_CMP   4'h8
`define OP_JZ    4'h9
`define OP_JNZ   4'hA
`define OP_JLT   4'hB
`define OP_JGT   4'hC
`define OP_HALT  4'hF

`endif
